    {"name": "test_d02_same_public_state_gives_the_accepted_ft_choice", "requirements": ["R01", "R02"]},
    {"name": "test_d03_one_original_selection_and_no_recomputation_in_validation_or_basis", "requirements": ["R03"]},
    {"name": "test_d04_proposal_rules_of_the_new_policy_and_unchanged_rules_of_the_three_old_ones", "requirements": ["R04", "R19"]},
    {"name": "test_d05_original_projection_keeps_its_meaning_and_the_shown_risk_is_the_targets", "requirements": ["R05"]},
    {"name": "test_d06_basis_fields_types_presence_and_binding", "requirements": ["R06"]},
    {"name": "test_d07_a_basis_of_another_proposal_or_with_wrong_content_is_refused", "requirements": ["R07"]},
    {"name": "test_d08_diagnosis_configuration_is_fixed_for_a_run_and_named_in_every_basis", "requirements": ["R03", "R06"]},
    {"name": "test_d09_first_input_and_flag_preparation_are_not_policy_decisions", "requirements": ["R08"]},
    {"name": "test_d10_entry_modes_new_fixed_adopt_and_flag_adopt_reach_a_policy_decision", "requirements": ["R09"]},
    {"name": "test_d11_input_permit_revalidates_the_current_state_without_recomputation", "requirements": ["R10", "R03"]},
    {"name": "test_d12_proposed_blocked_and_executed_wording_differ_and_guess_off_adds_no_input", "requirements": ["R11"]},
    {"name": "test_d13_worker_protocol_start_validate_ack_next_and_terminal", "requirements": ["R12", "R17"]},
    {"name": "test_d14_errors_in_selection_diagnosis_or_explanation_end_the_run_with_their_cause", "requirements": ["R13"]},
    {"name": "test_d15_job_keeps_info_and_basis_with_the_pending_proposal_and_drops_them_together", "requirements": ["R14", "R07", "R17"]},
    {"name": "test_d16_the_three_old_policies_keep_their_payload_rules_and_choices", "requirements": ["R19", "R17"]},
    {"name": "test_d17_end_lines_use_the_pre_input_basis_of_the_last_actual_input", "requirements": ["R16"]},
    {"name": "test_d18_explanation_extension_keeps_the_old_behaviour_and_long_numbers", "requirements": ["R21", "R18"]},
    {"name": "test_d19_fixed_strings_and_help_agree_with_the_explanation_module", "requirements": ["R18"]},
    {"name": "test_d20_the_parent_side_module_imports_no_solver_or_experiment_module", "requirements": ["R20"]}
   ]},
  {"module": "tests.test_live_k_d23_ui", "class": "LiveKD23UITests",
   "material": "비표시 화면(offscreen)의 실제 MinesweeperUI와 실제 엔진, 수용된 화면 시험의 가짜 job 방식(실제 KOwner와 근거 작성기를 같은 프로세스에서 쓴다). 전시 기기의 화면·입력 확인이 아니다",
