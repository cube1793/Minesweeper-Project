 "requirements": {
  "R01": "같은 공개 상태에서 새 K의 입력·분류·사유가 수용된 FT(select_combined_policy)와 같다",
  "R02": "D2 적용, 선처리(최소 위험과 같은 경우와 높은 경우), 동률 변경, 원 선택 유지가 각각 나온다",
  "R03": "한 결정에 K 분석 1회, K-LC1 원 선택 1회. 제안 시점 검증, 입력 직전 검증, 설명은 정밀 계산 0회. 진단 호출 수는 구성대로",
  "R04": "새 식별자의 제안 조건이 맞고 기존 세 정책의 조건은 그대로다(느슨해지지 않는다)",
  "R05": "probabilities는 원 제안의 표 그대로다. 표시 위험은 실제 대상의 값이다",
  "R06": "근거의 필드, 정확한 타입, 존재 조건, 결속",
  "R07": "다른 제안의 근거, 누락·초과, 잘못된 타입·좌표·위험·실행 식별·진단 구성의 거부",
  "R08": "첫 입력과 깃발 준비 입력에는 결합 선택, 진단, 근거가 없다. 준비가 끝난 뒤의 첫 결정에는 있다",
  "R09": "네 진입 방식에서 정책 결정에 도달한다",
  "R10": "입력 직전 검증이 현재 상태에 대해 다시 이루어지고 오래된 상태와 바뀐 객체를 거부한다",
  "R11": "추측 OFF를 우회하지 않는다. 제안·차단·실제 입력의 문구가 다르다",
  "R12": "START/NEXT → PROPOSAL → VALIDATE → ADMITTED → 실제 입력 → ACK의 연결, 종료 뒤 분석 없음",
  "R13": "선택·진단·설명의 오류는 입력 없이 그 실행을 끝내고 원인(단계, 예외 종류, 메시지)을 남긴다. 다른 정책으로 진행하지 않는다",
  "R14": "대기 제안, info, 근거의 수명이 같다. 일시정지는 유지, 수동 개입·정책 변경·취소·오래된 제안은 폐기",
  "R15": "실제 엔진 입력 뒤에만 입력 기록에 근거가 붙는다. 입력 허가나 고정 간격 대기는 기록이 아니다",
  "R16": "WON에는 패배 설명이 없다. 추측 LOST는 마지막 실제 입력의 입력 전 근거로 설명한다. 첫 입력, 수동 입력, 근거 없는 입력은 확인 가능한 범위만 적는다",
  "R17": "기존 info의 표시와 수명이 그대로다. 새 K에도 info가 붙는다",
  "R18": "화면: 새 K의 이름, 짧은 줄, 접힌 상세, 도움말, 긴 수치, 추측 대기 표시",
  "R19": "기존 세 K 정책의 payload, 조건, 선택이 그대로다. 선택 목록의 기대값만 한 항목 늘어난다",
  "R20": "부모가 적재하는 모듈(live_k_basis)은 풀이·실험 모듈을 import하지 않는다",
  "R21": "설명 모듈의 기존 공개 동작은 그대로이고 추가 계약(state, loss_lines_for)이 맞다"
 },
 "new_modules": [
  {"module": "tests.test_live_k_d23", "class": "LiveKD23Tests",
   "material": "owner 단위(공개 관측만), 자료형, worker 규약(프로세스 없이 serve를 직접 구동), 실제 LivePolicyJob에 가짜 프로세스. 엔진을 만들지 않는다",
   "tests": [
